		function Tbl1.gRO()
			-- upvalues: Tbl1 (ref)
			local _ = Tbl1.resolveChunk("bundled").loadModule("gDC")
			local _ = Tbl1.resolveChunk("bundled").loadModule("gRP").PaymentsProtocol.default
			
			function LUAUFORGE_MODULE_GLOBALS_gRO_calculateMoreAmount(List)
				if List == nil or #List == 0 then
					return {}
				end
				local v55 = nil
				
				for _, value in List do
					if v55 == nil or value.robuxAmount < v55.robuxAmount then
						v55 = value
					end
				end
				for _, value1 in List do
					local RobuxAmountDelta = value1.robuxAmount - v55.robuxAmount * (value1.price / v55.price)
					
					if RobuxAmountDelta > 0 then
						value1.robuxMoreAmount = math.floor((RobuxAmountDelta + 50) / 100) * 100
					end
				end
				return List
			end
			
			return {
				formatIapProducts = function(PremiumRobux)
					local List = {}
					
					for _, value in PremiumRobux do
						table.insert(List, {
							productId = value.productId,
							price = value.price,
							packageId = value.mobileProductId,
							robuxAmount = value.robuxAmount,
							currencyAmountStr = value.currencySymbol .. tostring(value.price)
						})
					end
					return LUAUFORGE_MODULE_GLOBALS_gRO_calculateMoreAmount(List)
				end,
				formatNativeRobuxProducts = function(Products)
					local List = {}
					
					for _, product in Products do
						table.insert(List, {
							productId = product.productId,
							price = product.price,
							packageId = product.nativeProductId,
							robuxAmount = product.robuxAmount,
							currencyAmountStr = product.displayPrice
						})
					end
					return LUAUFORGE_MODULE_GLOBALS_gRO_calculateMoreAmount(List)
				end
			}
		end
		
