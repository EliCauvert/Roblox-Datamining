		function Tbl1.fSy()
			-- upvalues: Tbl1 (ref)
			local FSz = Tbl1.loadModule("fSz")
			local FSA = Tbl1.loadModule("fSA")
			local FSB = Tbl1.resolveChunk("bundled").loadModule("fSB")
			
			local function _(p51): boolean
				-- upvalues: FSA (copy)
				for _, value in pairs(FSA) do
					if p51 == value then
						return true
					end
				end
				return false
			end
			
			return function(List, Text)
				-- upvalues: FSz (copy), FSA (copy), FSB (copy)
				local ExternalLinks = {}
				local GroupLink = nil
				local Flag = nil
				
				for _, value in ipairs(List) do
					local FromJsonDataResult = FSz.fromJsonData(value)
					local Type1 = FromJsonDataResult.type
					Flag = false
					
					for _, value1 in pairs(FSA) do
						if Type1 == value1 then
							Flag = true
							break
						end
					end
					if not Flag then
						warn("Can NOT recognize " .. FromJsonDataResult.type .. " as a valid Social Link Type!")
					elseif FromJsonDataResult.type ~= FSA.RobloxGroup then
						table.insert(ExternalLinks, FromJsonDataResult)
					elseif GroupLink then
						warn("Detected multiple " .. FromJsonDataResult.type .. " links for universe " .. Text .. "!")
					else
						GroupLink = FromJsonDataResult
						
						if FSB.FFlagIsSetupEnabled and GroupLink.url ~= nil then
							local Parts = string.split(GroupLink.url, "/")
							local Part = Parts[#Parts]
							
							if tonumber(Part) ~= nil then
								GroupLink.communityId = Part
							end
						end
					end
				end
				return { externalLinks = ExternalLinks, groupLink = GroupLink }
			end
		end
		
