				-- upvalues: HiD (copy), Module (copy)
				HiD:info("pageLoaded")
				self._diagImpl:reportCounter(Module.DiagCounters.UserLoadedPage, 1)
			end
			
			function Module:userLoadedSocialTab()
				-- upvalues: Module (copy)
				self._eventStreamImpl:setRBXEventStream("roactChat", "userLoadedChat", { uid = self.localUserId })
				self._diagImpl:reportCounter(Module.DiagCounters.UserLoadedSocialTab, 1)
			end
			
