		function Tbl1.fTr()
			-- upvalues: Tbl1 (ref)
			local FTs = Tbl1.loadModule("fTs")
			local FTt = Tbl1.loadModule("fTt")
			local FTu = Tbl1.resolveChunk("bundled").loadModule("fTu")
			
			local function _(p50): boolean
				-- upvalues: FTt (copy)
				for _, value in pairs(FTt) do
					if p50 == value then
						return true
					end
				end
				return false
			end
			
			return function(List, Text)
				-- upvalues: FTs (copy), FTt (copy), FTu (copy)
				local ExternalLinks = {}
				local GroupLink = nil
				local Flag = nil
				
				for _, value in ipairs(List) do
					local FromJsonDataResult = FTs.fromJsonData(value)
					local Type1 = FromJsonDataResult.type
					Flag = false
					
					for _, value1 in pairs(FTt) do
						if Type1 == value1 then
							Flag = true
							break
						end
					end
					if not Flag then
						warn("Can NOT recognize " .. FromJsonDataResult.type .. " as a valid Social Link Type!")
					elseif FromJsonDataResult.type ~= FTt.RobloxGroup then
						table.insert(ExternalLinks, FromJsonDataResult)
					elseif GroupLink then
						warn("Detected multiple " .. FromJsonDataResult.type .. " links for universe " .. Text .. "!")
					else
						GroupLink = FromJsonDataResult
						
						if FTu.FFlagIsSetupEnabled and GroupLink.url ~= nil then
							local Parts = string.split(GroupLink.url, "/")
							local Part = Parts[#Parts]
							
							if tonumber(Part) ~= nil then
								GroupLink.communityId = Part
							end
						end
					end
				end
				return { externalLinks = ExternalLinks, groupLink = GroupLink }
			end
		end
		
