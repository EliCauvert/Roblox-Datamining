				-- upvalues: HiD (copy), Llama (copy)
				HiD:info("eventName: buttonClick btn: {}{}", Btn, self:_toStringAdditionalArgs(p295))
				self._eventStreamImpl:setRBXEventStream("SocialTab", "buttonClick", (Llama.Dictionary.join(p295 or {}, { btn = Btn, uid = self.localUserId })))
