		function Tbl1.esg()
			-- upvalues: Tbl1 (ref)
			local ErP = Tbl1.loadModule("erP")
			local EntityTypes = Tbl1.loadModule("esa").Analytics.Enums.EntityTypes
			local Esc = Tbl1.loadModule("esc")
			local Esh = Tbl1.loadModule("esh")
			local GetResult = Tbl1.loadModule("esm").Presence.PresenceStore.get()
			local config = { skipFetch = true }
			
			return function(p18, p19, Namespace)
				-- upvalues: Esh (copy), ErP (copy), GetResult (copy), config (copy), EntityTypes (copy), Esc (copy)
				local EshResult = Esh()
				
				return ErP.useCallback(function(List)
					-- upvalues: p18 (copy), GetResult (upval), config (upval), EntityTypes (upval), p19 (copy), EshResult (copy), Esc (upval), Namespace (copy)
					local TargetUserId = ""
					local AbsolutePosition = ""
					local Rank = ""
					local ContextType = ""
					local EntityType = ""
					local RowInSort = ""
					local Presence = ""
					
					for _, value in ipairs(List) do
						local v4 = p18[value]
						
						if v4 then
							local DataResult = GetResult.GetPresenceByUserId(tostring(v4.id), config).data(false)
							local UserPresenceType = DataResult and DataResult.userPresenceType
							local IsContact = v4.type == "Contact"
							TargetUserId ..= v4.id or (v4.entityId or "") .. ","
							AbsolutePosition ..= value .. ","
							Rank ..= v4.rank or "" .. ","
							ContextType ..= v4.contextProps and v4.contextProps.contextType or "" .. ","
							EntityType ..= if IsContact then EntityTypes.Contact else "" .. ","
							RowInSort ..= math.floor((value - 1) / p19) + 1 .. ","
							Presence ..= UserPresenceType and tostring(UserPresenceType) or "" .. ","
						end
					end
					EshResult(Esc.UserTileImpression, {
