		function Tbl1.emv()
			-- upvalues: Tbl1 (ref)
			local Eme = Tbl1.loadModule("eme")
			local EntityTypes = Tbl1.loadModule("emp").Analytics.Enums.EntityTypes
			local Emr = Tbl1.loadModule("emr")
			local Emw = Tbl1.loadModule("emw")
			local GetResult = Tbl1.loadModule("emB").Presence.PresenceStore.get()
			local config = { skipFetch = true }
			
			return function(p18, p19, Namespace)
				-- upvalues: Emw (copy), Eme (copy), GetResult (copy), config (copy), EntityTypes (copy), Emr (copy)
				local EmwResult = Emw()
				
				return Eme.useCallback(function(List)
					-- upvalues: p18 (copy), GetResult (upval), config (upval), EntityTypes (upval), p19 (copy), EmwResult (copy), Emr (upval), Namespace (copy)
					local TargetUserId = ""
					local AbsolutePosition = ""
					local Rank = ""
					local ContextType = ""
					local EntityType = ""
					local RowInSort = ""
					local Presence = ""
					
					for _, value in ipairs(List) do
						local v4 = p18[value]
						
						if v4 then
							local DataResult = GetResult.GetPresenceByUserId(tostring(v4.id), config).data(false)
							local UserPresenceType = DataResult and DataResult.userPresenceType
							local IsContact = v4.type == "Contact"
							TargetUserId ..= v4.id or (v4.entityId or "") .. ","
							AbsolutePosition ..= value .. ","
							Rank ..= v4.rank or "" .. ","
							ContextType ..= v4.contextProps and v4.contextProps.contextType or "" .. ","
							EntityType ..= if IsContact then EntityTypes.Contact else "" .. ","
							RowInSort ..= math.floor((value - 1) / p19) + 1 .. ","
							Presence ..= UserPresenceType and tostring(UserPresenceType) or "" .. ","
						end
					end
					EmwResult(Emr.UserTileImpression, {
						namespace = Namespace,
						targetUserId = TargetUserId,
						absolutePosition = AbsolutePosition,
						rank = Rank,
						contextType = ContextType,
						entityType = EntityType,
						rowInSort = RowInSort,
						presence = Presence
					})
				end, { EmwResult, p18, p19, Namespace })
			end
		end
		
