		function Tbl1.esh()
			-- upvalues: Tbl1 (ref)
			local ErP = Tbl1.loadModule("erP")
			local Esi = Tbl1.loadModule("esi")
			local ShallowEqualFunction = Tbl1.loadModule("erQ").shallowEqual
			local ErZ = Tbl1.loadModule("erZ")
			local Esj = Tbl1.loadModule("esj")
			local Esl = Tbl1.loadModule("AddFriendsStableAnalyticsFields")
			
			return function(Current)
				-- upvalues: ErP (copy), ErZ (copy), Esl (copy), ShallowEqualFunction (copy), Esj (copy), Esi (copy)
				local UseMemoResult = ErP.useMemo(function()
					-- upvalues: ErZ (upval)
					return ErZ({ infoForAllEvents = {} }).fireAnalyticsEvent
				end, {})
				local Current1 = Current
				
				if Esl then
					local UseRefResult = ErP.useRef(Current)
					
					if not ShallowEqualFunction(UseRefResult.current, Current) then
						UseRefResult.current = Current
					end
					Current1 = UseRefResult.current
				end
				return ErP.useCallback(function(p18, p19)
					-- upvalues: Esj (upval), UseMemoResult (copy), Esi (upval), Current1 (ref)
					return UseMemoResult(p18, Esi.Dictionary.join(p19 or {}, Current1 or {}, { recommendationSessionId = Esj.getPymkSessionId() }))
				end, { Current1, if Esl then UseMemoResult else nil })
			end
		end
		
