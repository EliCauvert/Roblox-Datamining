		function Tbl1.erx()
			-- upvalues: Tbl1 (ref)
			local Erf = Tbl1.loadModule("erf")
			local Ery = Tbl1.loadModule("ery")
			local ShallowEqualFunction = Tbl1.loadModule("erg").shallowEqual
			local Erp = Tbl1.loadModule("erp")
			local Erz = Tbl1.loadModule("erz")
			local ErB = Tbl1.loadModule("AddFriendsStableAnalyticsFields")
			
			return function(Current)
				-- upvalues: Erf (copy), Erp (copy), ErB (copy), ShallowEqualFunction (copy), Erz (copy), Ery (copy)
				local UseMemoResult = Erf.useMemo(function()
					-- upvalues: Erp (upval)
					return Erp({ infoForAllEvents = {} }).fireAnalyticsEvent
				end, {})
				local Current1 = Current
				
				if ErB then
					local UseRefResult = Erf.useRef(Current)
					
					if not ShallowEqualFunction(UseRefResult.current, Current) then
						UseRefResult.current = Current
					end
					Current1 = UseRefResult.current
				end
				return Erf.useCallback(function(p18, p19)
					-- upvalues: Erz (upval), UseMemoResult (copy), Ery (upval), Current1 (ref)
					return UseMemoResult(p18, Ery.Dictionary.join(p19 or {}, Current1 or {}, { recommendationSessionId = Erz.getPymkSessionId() }))
				end, { Current1, if ErB then UseMemoResult else nil })
			end
		end
		
