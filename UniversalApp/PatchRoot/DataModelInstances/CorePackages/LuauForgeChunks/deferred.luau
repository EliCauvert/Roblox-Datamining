		function Tbl1.elR()
			-- upvalues: Tbl1 (ref)
			local ElA = Tbl1.loadModule("elA")
			local EntityTypes = Tbl1.loadModule("elL").Analytics.Enums.EntityTypes
			local ElN = Tbl1.loadModule("elN")
			local ElS = Tbl1.loadModule("elS")
			local GetResult = Tbl1.loadModule("elX").Presence.PresenceStore.get()
			local config = { skipFetch = true }
			
			return function(p18, p19, Namespace)
				-- upvalues: ElS (copy), ElA (copy), GetResult (copy), config (copy), EntityTypes (copy), ElN (copy)
				local ElSResult = ElS()
				
