		function Tbl1.emw()
			-- upvalues: Tbl1 (ref)
			local Eme = Tbl1.loadModule("eme")
			local Emx = Tbl1.loadModule("emx")
			local ShallowEqualFunction = Tbl1.loadModule("emf").shallowEqual
			local Emo = Tbl1.loadModule("emo")
			local Emy = Tbl1.loadModule("emy")
			local EmA = Tbl1.loadModule("AddFriendsStableAnalyticsFields")
			
			return function(Current)
				-- upvalues: Eme (copy), Emo (copy), EmA (copy), ShallowEqualFunction (copy), Emy (copy), Emx (copy)
				local UseMemoResult = Eme.useMemo(function()
					-- upvalues: Emo (upval)
					return Emo({ infoForAllEvents = {} }).fireAnalyticsEvent
				end, {})
				local Current1 = Current
				
				if EmA then
					local UseRefResult = Eme.useRef(Current)
					
					if not ShallowEqualFunction(UseRefResult.current, Current) then
						UseRefResult.current = Current
					end
					Current1 = UseRefResult.current
				end
				return Eme.useCallback(function(p18, p19)
					-- upvalues: Emy (upval), UseMemoResult (copy), Emx (upval), Current1 (ref)
					return UseMemoResult(p18, Emx.Dictionary.join(p19 or {}, Current1 or {}, { recommendationSessionId = Emy.getPymkSessionId() }))
				end, { Current1, if EmA then UseMemoResult else nil })
			end
		end
		
