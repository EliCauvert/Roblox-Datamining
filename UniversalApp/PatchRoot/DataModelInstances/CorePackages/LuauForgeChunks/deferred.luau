		function Tbl1.erw()
			-- upvalues: Tbl1 (ref)
			local Erf = Tbl1.loadModule("erf")
			local EntityTypes = Tbl1.loadModule("erq").Analytics.Enums.EntityTypes
			local Ers = Tbl1.loadModule("ers")
			local Erx = Tbl1.loadModule("erx")
			local GetResult = Tbl1.loadModule("erC").Presence.PresenceStore.get()
			local config = { skipFetch = true }
			
			return function(p18, p19, Namespace)
				-- upvalues: Erx (copy), Erf (copy), GetResult (copy), config (copy), EntityTypes (copy), Ers (copy)
				local ErxResult = Erx()
				
				return Erf.useCallback(function(List)
					-- upvalues: p18 (copy), GetResult (upval), config (upval), EntityTypes (upval), p19 (copy), ErxResult (copy), Ers (upval), Namespace (copy)
					local TargetUserId = ""
					local AbsolutePosition = ""
					local Rank = ""
					local ContextType = ""
					local EntityType = ""
					local RowInSort = ""
					local Presence = ""
					
					for _, value in ipairs(List) do
						local v4 = p18[value]
						
						if v4 then
							local DataResult = GetResult.GetPresenceByUserId(tostring(v4.id), config).data(false)
							local UserPresenceType = DataResult and DataResult.userPresenceType
							local IsContact = v4.type == "Contact"
							TargetUserId ..= v4.id or (v4.entityId or "") .. ","
							AbsolutePosition ..= value .. ","
							Rank ..= v4.rank or "" .. ","
							ContextType ..= v4.contextProps and v4.contextProps.contextType or "" .. ","
							EntityType ..= if IsContact then EntityTypes.Contact else "" .. ","
							RowInSort ..= math.floor((value - 1) / p19) + 1 .. ","
							Presence ..= UserPresenceType and tostring(UserPresenceType) or "" .. ","
						end
					end
					ErxResult(Ers.UserTileImpression, {
						namespace = Namespace,
						targetUserId = TargetUserId,
						absolutePosition = AbsolutePosition,
						rank = Rank,
						contextType = ContextType,
						entityType = EntityType,
						rowInSort = RowInSort,
						presence = Presence
					})
				end, { ErxResult, p18, p19, Namespace })
