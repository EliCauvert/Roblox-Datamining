				local Name = Hev(p309.navigation, false).current.name
				local Name1 = HevResult.current.name
				
				if p308.isNavigating and Name1 ~= Name then
					p308:trackTopLevelPageLatency()
					p308.isNavigating = false
				end
			end
			
