		function Tbl1.fKK()
			-- upvalues: Tbl1 (ref)
			local FKL = Tbl1.loadModule("fKL")
			local FKM = Tbl1.loadModule("fKM")
			local FKN = Tbl1.resolveChunk("bundled").loadModule("fKN")
			
			local function _(p51): boolean
				-- upvalues: FKM (copy)
				for _, value in pairs(FKM) do
					if p51 == value then
						return true
					end
				end
				return false
			end
			
			return function(List, Text)
				-- upvalues: FKL (copy), FKM (copy), FKN (copy)
				local ExternalLinks = {}
				local GroupLink = nil
				local Flag = nil
				
				for _, value in ipairs(List) do
					local FromJsonDataResult = FKL.fromJsonData(value)
					local Type1 = FromJsonDataResult.type
					Flag = false
					
					for _, value1 in pairs(FKM) do
						if Type1 == value1 then
							Flag = true
							break
						end
					end
					if not Flag then
						warn("Can NOT recognize " .. FromJsonDataResult.type .. " as a valid Social Link Type!")
					elseif FromJsonDataResult.type ~= FKM.RobloxGroup then
						table.insert(ExternalLinks, FromJsonDataResult)
					elseif GroupLink then
						warn("Detected multiple " .. FromJsonDataResult.type .. " links for universe " .. Text .. "!")
					else
						GroupLink = FromJsonDataResult
						
						if FKN.FFlagIsSetupEnabled and GroupLink.url ~= nil then
							local Parts = string.split(GroupLink.url, "/")
							local Part = Parts[#Parts]
							
							if tonumber(Part) ~= nil then
								GroupLink.communityId = Part
							end
						end
					end
				end
				return { externalLinks = ExternalLinks, groupLink = GroupLink }
			end
		end
		
