				local ResponseCode = if typeof(p18) == "table" then p18.responseCode else nil
				local ErrorMessage = if typeof(p18) == "table" then p18.errorMessage else nil
				
				if ResponseCode == nil then
					return { kind = VerifyErrorKind.Network, message = ErrorMessage }
				end
				if p19 ~= nil then
					local ExtractErrorCodesResult = extractErrorCodes(ErrorMessage)
					
					if ExtractErrorCodesResult ~= nil then
						for _, value in ExtractErrorCodesResult do
							if p19[value] ~= nil then
