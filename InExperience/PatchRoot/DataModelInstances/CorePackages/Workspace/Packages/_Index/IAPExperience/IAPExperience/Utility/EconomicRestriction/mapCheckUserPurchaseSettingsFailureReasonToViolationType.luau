local IAPExperience = script:FindFirstAncestor("IAPExperience")
local checkUserPurchaseSettingsFailureReasonModule = require(IAPExperience.Enums.CheckUserPurchaseSettingsFailureReason)
local economicRestrictionsViolationTypeModule = require(IAPExperience.Enums.EconomicRestrictionsViolationType)

return function(p1)
	-- upvalues: checkUserPurchaseSettingsFailureReasonModule (ref), economicRestrictionsViolationTypeModule (ref)
	return if p1 == checkUserPurchaseSettingsFailureReasonModule.Chargeback then economicRestrictionsViolationTypeModule.Chargeback elseif p1 == checkUserPurchaseSettingsFailureReasonModule.AbuseOfAffiliateSystem then economicRestrictionsViolationTypeModule.AbuseOfAffiliateSystem elseif p1 == checkUserPurchaseSettingsFailureReasonModule.AttemptedUnauthorizedPaymentMethodUse then economicRestrictionsViolationTypeModule.AttemptedUnauthorizedPaymentMethodUse elseif p1 == checkUserPurchaseSettingsFailureReasonModule.PaymentAuthorizationAttempt then economicRestrictionsViolationTypeModule.PaymentAuthorizationAttempt elseif p1 == checkUserPurchaseSettingsFailureReasonModule.RepeatedRefundRequests then economicRestrictionsViolationTypeModule.RepeatedRefundRequests elseif p1 == checkUserPurchaseSettingsFailureReasonModule.SuspiciousAccountPatterns then economicRestrictionsViolationTypeModule.SuspiciousAccountPatterns elseif p1 == checkUserPurchaseSettingsFailureReasonModule.SuspiciousRefundRequests then economicRestrictionsViolationTypeModule.SuspiciousRefundRequests elseif p1 == checkUserPurchaseSettingsFailureReasonModule.UnauthorizedPurchase then economicRestrictionsViolationTypeModule.UnauthorizedPurchase elseif p1 == checkUserPurchaseSettingsFailureReasonModule.UseOfUnauthorizedOffPlatformTransactions then economicRestrictionsViolationTypeModule.UseOfUnauthorizedOffPlatformTransactions elseif p1 == checkUserPurchaseSettingsFailureReasonModule.VirtualEconomyAbuse then economicRestrictionsViolationTypeModule.VirtualEconomyAbuse else economicRestrictionsViolationTypeModule.None
end